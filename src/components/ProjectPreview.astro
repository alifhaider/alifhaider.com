---
type PreviewKind = 'nulandia' | 'hyde' | 'definya' | 'carehub' | 'websec' | 'studio'

interface Props {
  preview: PreviewKind
}

const { preview } = Astro.props
const previewClasses = [
  'pointer-events-none absolute right-8 top-1/2 z-10',
  'h-36 w-56 -translate-y-1/2 scale-[.97]',
  'border border-line-strong bg-bg shadow-[0_14px_30px_rgba(0,0,0,.09)]',
  'opacity-0 transition-[opacity,scale,translate] duration-200',
  'group-hover:-translate-x-2 group-hover:scale-100 group-hover:opacity-100',
  'group-focus-visible:-translate-x-2 group-focus-visible:scale-100 group-focus-visible:opacity-100',
  'motion-reduce:transition-none max-md:hidden',
].join(' ')
---

<div class={previewClasses} aria-hidden="true">
  {preview === 'nulandia' && (
    <div class="grid h-full grid-cols-2 gap-2 overflow-hidden p-4 text-text">
      <strong class="col-span-2 text-[11px] font-bold">Nulandia</strong>
      <span class="border border-line p-2 text-[9px] text-muted">Content</span>
      <span class="border border-line p-2 text-[9px] text-muted">Weapons</span>
      <span class="border border-line p-2 text-[9px] text-muted">Quests</span>
      <span class="absolute right-4 top-4 h-0.5 w-5 bg-line-strong" aria-hidden="true"></span>
    </div>
  )}

  {preview === 'hyde' && (
    <div class="p-3.5">
      <div class="h-19 border border-line-strong bg-[repeating-linear-gradient(135deg,transparent_0_12px,var(--line)_13px_14px)]" aria-hidden="true"></div>
      <span class="mt-3 block font-serif text-sm">Reserve your stay</span>
    </div>
  )}

  {preview === 'definya' && (
    <div class="relative h-full bg-text p-4 text-bg">
      <span class="font-serif text-lg">DEF</span>
      <span class="absolute right-6 top-6 size-3.5 rounded-full border border-current opacity-70" aria-hidden="true"></span>
      <span class="absolute right-13 top-14 size-3.5 rounded-full border border-current opacity-70" aria-hidden="true"></span>
      <span class="absolute bottom-5 left-16 size-3.5 rounded-full border border-current opacity-70" aria-hidden="true"></span>
    </div>
  )}

  {preview === 'carehub' && (
    <div class="grid grid-cols-5 gap-1.5 p-4">
      <strong class="col-span-5 mb-1 font-serif text-sm font-normal">June</strong>
      <span class="text-center text-[7px] text-soft">Mon</span>
      <span class="text-center text-[7px] text-soft">Tue</span>
      <span class="text-center text-[7px] text-soft">Wed</span>
      <span class="text-center text-[7px] text-soft">Thu</span>
      <span class="text-center text-[7px] text-soft">Fri</span>
      <span class="mx-auto mt-1 block size-4.5 border border-text" aria-hidden="true"></span>
    </div>
  )}

  {preview === 'websec' && (
    <div class="p-4">
      <strong class="mb-3 block text-[11px] font-medium">Overview</strong>
      <span class="mb-2 block h-1.5 w-3/4 bg-line" aria-hidden="true"></span>
      <span class="mb-2 block h-1.5 w-1/2 bg-line" aria-hidden="true"></span>
      <span class="block h-1.5 w-2/3 bg-line" aria-hidden="true"></span>
    </div>
  )}

  {preview === 'studio' && (
    <div class="p-4">
      <span class="mb-3.5 block font-serif text-lg">Generate</span>
      <span class="mb-2 block h-1.25 w-[72%] bg-line" aria-hidden="true"></span>
      <span class="block h-1.25 w-[51%] bg-line" aria-hidden="true"></span>
    </div>
  )}
</div>
