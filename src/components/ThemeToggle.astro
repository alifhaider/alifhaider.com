---
---

<button
	type="button"
	class="group flex w-24 flex-col gap-1.5 border-0 bg-transparent p-0 text-[10px] font-medium uppercase leading-none tracking-[0.12em] text-soft transition-colors hover:text-text"
	data-theme-toggle
	aria-label="Switch to night mode"
	aria-pressed="false"
>
	<div class="flex w-full items-center justify-between">
		<span class="transition-opacity duration-300" data-label="day"> Day </span>

		<span class="transition-opacity duration-300" data-label="night">
			Night
		</span>
	</div>

	<div class="relative h-2 w-full" aria-hidden="true">
		<!-- Base line -->
		<span
			class="absolute inset-x-0 top-1/2 h-px -translate-y-1/2 bg-current/20"
		></span>

		<!-- Active line -->
		<span
			class="absolute left-0 top-1/2 h-0.5 w-1/2 -translate-y-1/2 bg-current transition-[left] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
			data-active-line
		></span>

		<!-- Indicator -->
		<span
			class="pointer-events-none absolute left-0 top-1/2 size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full border border-current bg-current transition-[left] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
			data-indicator
		></span>
	</div>
</button>

<script>
const initThemeToggle = () => {
	document
		.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
		.forEach((toggle) => {
			if (toggle.dataset.initialized) return;

			toggle.dataset.initialized = "true";

			const day = toggle.querySelector<HTMLElement>('[data-label="day"]');

			const night = toggle.querySelector<HTMLElement>('[data-label="night"]');

			const activeLine =
				toggle.querySelector<HTMLElement>("[data-active-line]");

			const indicator = toggle.querySelector<HTMLElement>("[data-indicator]");

			const sync = () => {
				const isDark = document.documentElement.dataset.theme === "dark";

				day?.classList.toggle("opacity-100", !isDark);
				day?.classList.toggle("opacity-40", isDark);

				night?.classList.toggle("opacity-100", isDark);
				night?.classList.toggle("opacity-40", !isDark);

				// Both the active line and indicator use the
				// exact same position.
				activeLine?.style.setProperty("left", isDark ? "50%" : "0%");

				indicator?.style.setProperty("left", isDark ? "100%" : "0%");

				toggle.setAttribute("aria-pressed", String(isDark));

				toggle.setAttribute(
					"aria-label",
					isDark ? "Switch to day mode" : "Switch to night mode",
				);
			};

			toggle.addEventListener("click", () => {
				const root = document.documentElement;

				const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";

				root.dataset.theme = nextTheme;
				localStorage.setItem("theme", nextTheme);

				sync();
			});

			sync();
		});
};

initThemeToggle();

document.addEventListener("astro:page-load", initThemeToggle);
</script>
