---
import { getCollection, render } from 'astro:content'
import ThemeToggle from '../../components/ThemeToggle.astro'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await render(post)

const { title, description, date, tags, readTime, project, projectHref } = post.data
const dateString = date.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
})
---

<Layout title={`${title} — Alif Haider`} description={description}>
	<main
		class="mx-auto w-[calc(100%-48px)] max-w-4xl sm:w-[calc(100%-28px)] sm:max-w-2xl"
	>
		<header
			class="flex min-h-18 items-center justify-between gap-5 border-b border-line sm:min-h-16"
		>
			<a class="font-serif text-2xl tracking-tight" href="/">Alif Haider</a>
			<div class="flex items-center gap-5 sm:gap-3">
				<a
					class="link link-hover text-xs text-muted"
					href="/blog/"
					>Blog</a>
				<ThemeToggle />
			</div>
		</header>

		<article class="py-20 sm:py-16">
			<header class="mx-auto max-w-4xl">
				{
					project && (
						<p class="mb-3.5">
							{projectHref ? (
								<a
									href={projectHref}
									target="_blank"
									rel="noreferrer"
									class="inline-flex items-center gap-1.5 rounded-full border border-line bg-surface px-3 py-1 text-[10px] uppercase tracking-wider text-muted hover:text-text hover:border-line-strong"
								>
									<span>{project}</span>
									<span aria-hidden="true">↗</span>
								</a>
							) : (
								<span class="inline-flex rounded-full border border-line bg-surface px-3 py-1 text-[10px] uppercase tracking-wider text-muted">
									{project}
								</span>
							)}
						</p>
					)
				}
				<p class="mb-3 text-tiny uppercase tracking-wider text-soft">
					{dateString}
					· {readTime}
				</p>
				<h1
					class="font-serif text-5xl font-normal leading-[0.96] tracking-tighter sm:text-6xl lg:text-7xl xl:text-[82px]"
				>
					{title}
				</h1>
				<p
					class="mt-6 max-w-3xl text-base leading-relaxed text-muted sm:text-sm"
				>
					{description}
				</p>
			</header>

			<div
				class="mx-auto mt-16 grid max-w-4xl grid-cols-[125px_minmax(0,1fr)] gap-12 sm:mt-12 sm:grid-cols-1 sm:gap-4"
			>
				<aside
					class="relative grid content-start gap-2 pt-1 text-xs leading-normal text-soft before:mb-1 before:block before:h-px before:w-7 before:bg-line-strong before:content-[''] sm:flex sm:flex-wrap sm:gap-x-3 sm:gap-y-2 sm:border-y sm:border-line sm:py-3 sm:pt-3 sm:before:hidden"
				>
					{tags.map((tag) => <span>{tag}</span>)}
				</aside>

				<div class="article-body min-w-0">
					<Content />
					<div
						class="mt-14 flex gap-4 border-t border-line pt-4 text-tiny text-soft"
					>
						<span class="uppercase tracking-wider">Filed under</span>
						<a
							class="link text-text"
							href="/blog/"
							>{tags.join(" · ")}</a>
					</div>
				</div>
			</div>
		</article>

		<footer class="flex justify-between py-6 text-tiny text-soft">
			<span>© 2026 Alif Haider</span><a
				class="link link-hover"
				href="/blog/"
				>More notes →</a>
		</footer>
	</main>
</Layout>
