---
import { getCollection, render } from "astro:content";
import ThemeToggle from "../../components/ThemeToggle.astro";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, description, date, tags, readTime } = post.data;
const dateString = date.toLocaleDateString("en-US", {
	month: "long",
	day: "numeric",
	year: "numeric",
});
---

<Layout title={`${title} — Alif Haider`} description={description}>
	<main
		class="mx-auto w-[min(1040px,calc(100%-48px))] max-[760px]:w-[min(100%-28px,700px)]"
	>
		<header
			class="flex min-h-[72px] items-center justify-between gap-[20px] border-b border-line max-[500px]:min-h-[62px]"
		>
			<a class="font-serif text-[23px] tracking-[-0.03em]" href="/"
				>Alif Haider</a
			>
			<div class="flex items-center gap-[22px] max-[500px]:gap-[13px]">
				<a
					class="text-[12px] text-muted underline-offset-[3px] hover:text-text hover:underline"
					href="/blog/"
					>Blog</a
				>
				<ThemeToggle />
			</div>
		</header>

		<article class="py-[80px_70px] max-[760px]:pt-[58px]">
			<header class="mx-auto max-w-[820px]">
				<p class="mb-[13px] text-[11px] uppercase tracking-[0.08em] text-soft">
					{dateString}
					· {readTime}
				</p>
				<h1
					class="font-serif text-[clamp(48px,7vw,82px)] font-normal leading-[0.96] tracking-[-0.055em] max-[500px]:text-[47px]"
				>
					{title}
				</h1>
				<p
					class="mt-[25px] max-w-[690px] text-[16px] leading-[1.75] text-muted max-[500px]:text-[14px]"
				>
					{description}
				</p>
			</header>

			<div
				class="mx-auto mt-[68px] grid max-w-[820px] grid-cols-[125px_minmax(0,1fr)] gap-[45px] max-[760px]:mt-[46px] max-[760px]:grid-cols-1 max-[760px]:gap-[15px]"
			>
				<aside
					class="relative grid content-start gap-[7px] pt-[5px] text-[10px] leading-normal text-soft before:mb-[5px] before:block before:h-px before:w-[28px] before:bg-line-strong before:content-[''] max-[760px]:flex max-[760px]:flex-wrap max-[760px]:gap-x-[13px] max-[760px]:gap-y-[8px] max-[760px]:border-y max-[760px]:border-line max-[760px]:py-[11px] max-[760px]:pt-[11px] max-[760px]:before:hidden"
				>
					{tags.map((tag) => <span>{tag}</span>)}
				</aside>

				<div class="article-body min-w-0">
					<Content />
					<div
						class="mt-[56px] flex gap-[15px] border-t border-line pt-[17px] text-[11px] text-soft"
					>
						<span class="uppercase tracking-[0.08em]">Filed under</span>
						<a
							class="text-text underline-offset-[3px] hover:underline"
							href="/blog/"
							>{tags.join(" · ")}</a
						>
					</div>
				</div>
			</div>
		</article>

		<footer class="flex justify-between py-[22px_30px] text-[11px] text-soft">
			<span>© 2026 Alif Haider</span
			><a
				class="underline-offset-[3px] hover:text-text hover:underline"
				href="/blog/"
				>More notes →</a
			>
		</footer>
	</main>
</Layout>
