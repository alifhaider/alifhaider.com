---
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "../layouts/Layout.astro";

const projects = [
	{
		year: "2025",
		title: "Nulandia",
		description: "Game administration & content tooling",
		stack: "React · TypeScript",
		href: "https://admin.nulandia.com/",
		preview: "nulandia",
	},
	{
		year: "2024",
		title: "Hyde Penthouse",
		description: "Multi-domain booking platform",
		stack: "Remix · Prisma",
		href: "https://hydepenthouses.abodems.com/",
		preview: "hyde",
	},
	{
		year: "2024",
		title: "Definya",
		description: "Full-stack MMORPG & realtime game systems",
		stack: "React · Node · Redis · WebSockets",
		href: "https://play.definya.com/",
		preview: "definya",
	},
	{
		year: "2023",
		title: "CareHub",
		description: "Appointments, scheduling & reservation logic",
		stack: "React · Remix · Prisma",
		href: "#",
		preview: "carehub",
	},
	{
		year: "2023",
		title: "WebSec",
		description: "Subscription SaaS, billing & account workflows",
		stack: "React · TypeScript · Stripe",
		href: "#",
		preview: "websec",
	},
	{
		year: "2026",
		title: "Generative Studio",
		description: "Image & video generation workflows",
		stack: "Next.js · Prisma · Postgres",
		href: "#",
		preview: "studio",
	},
];

const rowClasses = [
	"group relative grid items-center gap-5 border-b border-line",
	"grid-cols-[55px_minmax(0,1fr)_195px_20px]",
	"min-h-21 transition-[padding-left] duration-200",
	"hover:pl-2 motion-reduce:transition-none",
	"max-md:grid-cols-[48px_minmax(0,1fr)_18px]",
	"max-md:gap-3.5 max-md:min-h-20",
	"max-sm:hover:pl-0",
].join(" ");

const previewClasses = [
	"pointer-events-none absolute right-8 top-1/2 z-10",
	"h-36 w-56 -translate-y-1/2 scale-[.97]",
	"border border-line-strong bg-bg shadow-[0_14px_30px_rgba(0,0,0,.09)]",
	"opacity-0 transition-[opacity,scale,translate] duration-200",
	"group-hover:-translate-x-2 group-hover:scale-100 group-hover:opacity-100",
	"group-focus-visible:-translate-x-2 group-focus-visible:scale-100 group-focus-visible:opacity-100",
	"motion-reduce:transition-none max-md:hidden",
].join(" ");
---

<Layout>
	<div
		class="mx-auto grid max-w-295 grid-cols-[230px_minmax(0,1fr)] gap-18 px-7 max-md:block max-md:max-w-175 max-md:px-4 max-sm:px-3"
	>
		<!-- Sidebar -->
		<aside
			class="sticky top-0 flex h-screen flex-col py-8 pb-7 max-md:static max-md:grid max-md:h-auto max-md:grid-cols-[1fr_auto] max-md:gap-5 max-md:border-b max-md:border-line max-md:py-6 max-md:pb-4 max-sm:grid-cols-1"
		>
			<div>
				<a
					class="inline-block font-serif text-3xl tracking-[-0.035em]"
					href="#top"
				>
					Alif Haider
				</a>

				<p class="mt-1 text-sm leading-normal text-muted max-sm:mt-1">
					Software engineer<br>
					from Bangladesh.
				</p>
			</div>

			<div class="mt-16 pr-3.5 max-md:hidden">
				<p class="text-[13px] leading-relaxed text-muted">
					I build web applications across the stack — from React interfaces and
					routing to APIs, data, realtime services, and the infrastructure
					around them.
				</p>
			</div>

			<nav
				class="mt-9 grid gap-2.5 text-[13px] max-md:col-span-2 max-md:mt-2.5 max-md:flex max-md:gap-5 max-sm:order-2 max-sm:mt-1"
				aria-label="Primary navigation"
			>
				<a class="w-fit underline-offset-4 hover:underline" href="#work">
					Work
				</a>

				<a class="w-fit underline-offset-4 hover:underline" href="#about">
					About
				</a>

				<a class="w-fit underline-offset-4 hover:underline" href="/blog/">
					Blog
				</a>
			</nav>

			<div
				class="mt-auto max-md:col-span-2 max-md:m-0 max-md:flex max-md:items-center max-md:justify-between max-md:gap-5 max-sm:order-3"
			>
				<div
					class="flex max-w-52 flex-wrap gap-x-3.5 gap-y-2 max-md:max-w-none max-sm:gap-x-3 max-sm:gap-y-1.5"
				>
					<a
						class="text-xs text-muted underline-offset-4 hover:underline"
						href="https://github.com/alifhaider"
						target="_blank"
						rel="noreferrer"
					>
						GitHub
					</a>

					<a
						class="text-xs text-muted underline-offset-4 hover:underline"
						href="https://linkedin.com/in/alifhaider"
						target="_blank"
						rel="noreferrer"
					>
						LinkedIn
					</a>

					<a
						class="text-xs text-muted underline-offset-4 hover:underline"
						href="https://x.com/haider_alif"
						target="_blank"
						rel="noreferrer"
					>
						Twitter
					</a>

					<a
						class="text-xs text-muted underline-offset-4 hover:underline"
						href="https://www.facebook.com/"
						target="_blank"
						rel="noreferrer"
					>
						Facebook
					</a>

					<a
						class="text-xs text-muted underline-offset-4 hover:underline"
						href="https://www.instagram.com/"
						target="_blank"
						rel="noreferrer"
					>
						Instagram
					</a>

					<a
						class="text-xs text-muted underline-offset-4 hover:underline"
						href="https://wa.me/@ArabicFirstAlphabet"
						target="_blank"
						rel="noreferrer"
					>
						WhatsApp
					</a>
				</div>

				<div
					class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4 max-md:m-0 max-md:border-0 max-md:p-0"
				>
					<a
						class="text-xs text-muted underline-offset-4 hover:underline max-md:hidden"
						href="mailto:alifhaider57@gmail.com"
					>
						Email me ↗
					</a>

					<ThemeToggle />
				</div>
			</div>
		</aside>

		<!-- Main -->
		<main id="top" class="min-w-0">
			<!-- Hero -->
			<section class="border-b border-line py-20 max-md:py-14">
				<p class="mb-5 text-xs tracking-[0.02em] text-soft">Hello, I'm Alif.</p>

				<h1
					class="max-w-175 font-serif text-[clamp(3rem,7vw,4.875rem)] font-normal leading-[.98] tracking-tighter max-sm:text-5xl"
				>
					I make software for the web.
				</h1>

				<div
					class="mt-8 grid grid-cols-[minmax(0,1fr)_240px] items-start gap-13 max-md:grid-cols-1 max-md:gap-7"
				>
					<p class="max-w-155 text-sm leading-7 text-muted">
						Most of my work is with React and TypeScript, but I enjoy the parts
						that sit around the UI just as much: application architecture, APIs,
						databases, background jobs, realtime systems, and deployment.
					</p>

					<div class="border-l border-line-strong pl-4.5 max-md:max-w-105">
						<p class="mb-4 text-xs leading-7 text-muted">
							<span
								class="mb-1 block text-[10px] uppercase tracking-[0.09em] text-text"
							>
								Currently
							</span>
							building products, learning Astro, and exploring Go and Rust.
						</p>

						<p class="text-xs leading-7 text-muted">
							<span
								class="mb-1 block text-[10px] uppercase tracking-[0.09em] text-text"
							>
								Usually
							</span>
							working remotely with small teams and clients.
						</p>
					</div>
				</div>
			</section>

			<!-- Work -->
			<section id="work" class="pt-16">
				<div
					class="flex items-baseline justify-between gap-5 border-b border-line-strong pb-3.5 max-sm:pb-2.5"
				>
					<h2 class="text-[13px] font-semibold tracking-[0.01em]">
						Selected work
					</h2>

					<span class="text-[11px] text-soft"> 2023—2026 </span>
				</div>

				<div class="border-b border-line">
					{projects.map((project) => (
              <a
                class={rowClasses}
                href={project.href}
                target={project.href.startsWith("http") ? "_blank" : undefined}
                rel={project.href.startsWith("http") ? "noreferrer" : undefined}
              >
                <div class="text-[11px] text-soft">
                  {project.year}
                </div>

                <div class="min-w-0">
                  <h3 class="mb-1 text-base font-medium tracking-[-0.015em]">
                    {project.title}
                  </h3>

                  <p class="text-xs text-muted">
                    {project.description}
                  </p>
                </div>

                <div
                  class="text-right text-[11px] leading-normal text-soft max-md:hidden"
                >
                  {project.stack}
                </div>

                <span class="text-right text-sm text-soft">
                  ↗
                </span>

                <div class={previewClasses} aria-hidden="true">
                  {
                    project.preview === "nulandia" && (
                      <div class="grid h-full grid-cols-2 gap-2 overflow-hidden p-4 text-text">
                        <b class="col-span-2 text-[11px] font-bold">
                          Nulandia
                        </b>

                        <span class="border border-line p-2 text-[9px] text-muted">
                          Content
                        </span>

                        <span class="border border-line p-2 text-[9px] text-muted">
                          Weapons
                        </span>

                        <span class="border border-line p-2 text-[9px] text-muted">
                          Quests
                        </span>

                        <i class="absolute right-4 top-4 h-0.5 w-5 bg-line-strong" />
                      </div>
                    )
                  }

                  {
                    project.preview === "hyde" && (
                      <div class="p-3.5">
                        <div class="h-19 border border-line-strong bg-[repeating-linear-gradient(135deg,transparent_0_12px,var(--line)_13px_14px)]" />

                        <span class="mt-3 block font-serif text-sm">
                          Reserve your stay
                        </span>
                      </div>
                    )
                  }

                  {
                    project.preview === "definya" && (
                      <div class="relative h-full bg-text p-4 text-bg">
                        <span class="font-serif text-lg">
                          DEF
                        </span>

                        <i class="absolute right-6 top-6 size-3.5 rounded-full border border-current opacity-70" />
                        <i class="absolute right-13 top-14 size-3.5 rounded-full border border-current opacity-70" />
                        <i class="absolute bottom-5 left-16 size-3.5 rounded-full border border-current opacity-70" />
                      </div>
                    )
                  }

                  {
                    project.preview === "carehub" && (
                      <div class="grid grid-cols-5 gap-1.5 p-4">
                        <b class="col-span-5 mb-1 font-serif text-sm font-normal">
                          June
                        </b>

                        <span class="text-center text-[7px] text-soft">
                          Mon
                        </span>
                        <span class="text-center text-[7px] text-soft">
                          Tue
                        </span>
                        <span class="text-center text-[7px] text-soft">
                          Wed
                        </span>
                        <span class="text-center text-[7px] text-soft">
                          Thu
                        </span>
                        <span class="text-center text-[7px] text-soft">
                          Fri
                        </span>

                        <i class="mx-auto mt-1 block size-4.5 border border-text" />
                      </div>
                    )
                  }

                  {
                    project.preview === "websec" && (
                      <div class="p-4">
                        <b class="mb-3 block text-[11px] font-medium">
                          Overview
                        </b>

                        <i class="mb-2 block h-1.5 w-3/4 bg-line" />
                        <i class="mb-2 block h-1.5 w-1/2 bg-line" />
                        <i class="block h-1.5 w-2/3 bg-line" />
                      </div>
                    )
                  }

                  {project.preview === "studio" && ( <div class="p-4">
                        <span class="mb-3.5 block font-serif text-lg">
                          Generate
                        </span>

                        <i class="mb-2 block h-1.25 w-[72%] bg-line" />
                        <i class="block h-1.25 w-[51%] bg-line" />
                      </div>
                    )
                  }
                </div>
              </a>
            ))}
				</div>

				<p class="mt-4 text-xs text-soft">
					More work is available on
					<a
						class="text-text underline-offset-4 hover:underline"
						href="https://github.com/alifhaider"
						target="_blank"
						rel="noreferrer"
					>
						GitHub ↗
					</a
					>.
				</p>
			</section>

			<!-- About -->
			<section id="about" class="border-t border-line pt-16">
				<div
					class="flex items-baseline justify-between gap-5 border-b border-line-strong pb-3.5 max-sm:pb-2.5"
				>
					<h2 class="text-[13px] font-semibold tracking-[0.01em]">About</h2>

					<span class="text-[11px] text-soft"> A little context </span>
				</div>

				<div
					class="grid grid-cols-[1.08fr_.92fr] gap-16 pt-6 max-md:grid-cols-1 max-md:gap-7"
				>
					<p class="max-w-140 text-sm leading-7 text-muted">
						I started as a frontend developer and gradually found myself wanting
						to understand the whole system. These days I am happiest when I can
						take a feature from an empty screen through data modeling,
						implementation, deployment, and the less-obvious edge cases.
					</p>

					<div class="grid gap-4">
						<p class="text-xs leading-7 text-muted">
							<b class="font-medium text-text">Stack</b>
							React, TypeScript, Next.js, React Router, Node.js, Prisma
						</p>

						<p class="text-xs leading-7 text-muted">
							<b class="font-medium text-text">Experience</b>
							5+ years · freelance & remote teams
						</p>

						<p class="text-xs leading-7 text-muted">
							<b class="font-medium text-text">Interested in</b>
							Astro, Go, Rust, developer tools, games
						</p>
					</div>
				</div>
			</section>

			<!-- Contact -->
			<section class="mt-6 border-b border-line py-16">
				<p class="mb-5 text-xs tracking-[0.02em] text-soft">
					Have a project in mind?
				</p>

				<h2
					class="mb-6 font-serif text-[clamp(2.125rem,5vw,3.25rem)] font-normal leading-none tracking-[-0.045em]"
				>
					Let's make something useful.
				</h2>

				<a
					class="text-[13px] underline-offset-4 hover:underline"
					href="mailto:hello@alifhaider.dev"
				>
					hello@alifhaider.dev ↗
				</a>
			</section>

			<!-- Footer -->
			<footer class="flex justify-between pt-6 pb-8 text-[11px] text-soft">
				<span>© 2026 Alif Haider</span>

				<span class="max-sm:hidden"> Built for the web. </span>

				<a
					class="underline-offset-4 hover:underline"
					href="#top"
					aria-label="Back to top"
				>
					↑
				</a>
			</footer>
		</main>
	</div>
</Layout>
