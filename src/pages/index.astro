---
import ThemeToggle from "../components/ThemeToggle.astro";
import Layout from "../layouts/Layout.astro";

const projects = [
	{
		year: "2026",
		title: "WebSec",
		description: "SaaS billing, subscriptions & account management",
		stack: "React · Prisma · SQLite",
		href: "https://customers.websec.net/",
		preview: "websec",
	},
	{
		year: "2026",
		title: "Generative Studio",
		description:
			"Image and video generation platform with model integrations, credits, background processing, and asset management.",
		stack: "Next.js · Prisma · Postgres",
		href: "#",
		preview: "studio",
	},
	{
		year: "2025",
		title: "Nulandia Admin",
		description:
			"Tools for managing a game world, its content, and the people working behind it.",
		stack: "React · TypeScript",
		href: "https://admin.nulandia.com/",
		preview: "nulandia",
	},
	{
		year: "2024",
		title: "HydePenthouse",
		description: "Booking platform across multiple domains",
		stack: "Remix · Prisma",
		href: "https://hydepenthouses.abodems.com/",
		preview: "hyde",
	},
	{
		year: "2024",
		title: "Definya",
		description: "MMORPG game, realtime features & backend work",
		stack: "React · MongoDB · Redis · WebSockets",
		href: "https://play.definya.com/",
		preview: "definya",
	},
];

const rowClasses = [
	"group relative grid items-center gap-5 border-b border-line",
	"grid-cols-[55px_minmax(0,1fr)_195px_20px]",
	"min-h-21 transition-[padding-left] duration-200",
	"hover:pl-2 focus-visible:pl-2 motion-reduce:transition-none",
	"focus-visible:outline-none",
	"max-md:grid-cols-[48px_minmax(0,1fr)_18px]",
	"max-md:gap-3.5 max-md:min-h-20",
	"max-sm:hover:pl-0 max-sm:focus-visible:pl-0",
].join(" ");

const previewClasses = [
	"pointer-events-none absolute right-8 top-1/2 z-10",
	"h-36 w-56 -translate-y-1/2 scale-[.97]",
	"border border-line-strong bg-bg shadow-[0_14px_30px_rgba(0,0,0,.09)]",
	"opacity-0 transition-[opacity,scale,translate] duration-200",
	"group-hover:-translate-x-2 group-hover:scale-100 group-hover:opacity-100",
	"group-focus-visible:-translate-x-2 group-focus-visible:scale-100 group-focus-visible:opacity-100",
	"motion-reduce:transition-none max-md:hidden",
].join(" ");
---

<Layout>
	<div
		class="mx-auto grid max-w-295 grid-cols-[230px_minmax(0,1fr)] gap-18 px-7 max-md:block max-md:max-w-175 max-md:px-4 max-sm:px-3"
	>
		<!-- Sidebar -->
		<aside
			class="sticky top-0 flex h-screen flex-col py-8 pb-7 max-md:static max-md:grid max-md:h-auto max-md:grid-cols-[1fr_auto] max-md:gap-5 max-md:border-b max-md:border-line max-md:py-6 max-md:pb-4 max-sm:grid-cols-1"
		>
			<div>
				<a
					class="inline-block font-serif text-3xl tracking-[-0.035em] underline-offset-4 focus-visible:outline-none focus-visible:underline"
					href="#top"
				>
					Alif Haider
				</a>

				<p
					class="mt-1 text-sm leading-normal font-medium text-muted max-sm:mt-1"
				>
					Software engineer<br>
					<span class="text-xs font-normal">based in</span>
					Bangladesh.
				</p>
			</div>

			<p
				class="mt-16 pr-3.5 max-md:hidden text-[13px] leading-relaxed text-muted"
			>
				I build web applications with JavaScript and TypeScript, from the
				interface to the backend.
			</p>

			<nav
				class="mt-9 grid gap-2.5 text-[13px] max-md:col-span-2 max-md:mt-2.5 max-md:flex max-md:gap-5 max-sm:order-2 max-sm:mt-1"
				aria-label="Primary navigation"
			>
				<a
					class="w-fit underline-offset-4 hover:underline focus-visible:outline-none focus-visible:underline"
					href="#work"
				>
					Work
				</a>

				<a
					class="w-fit underline-offset-4 hover:underline focus-visible:outline-none focus-visible:underline"
					href="#about"
				>
					About
				</a>

				<a
					class="w-fit underline-offset-4 hover:underline focus-visible:outline-none focus-visible:underline"
					href="/blog/"
				>
					Blog
				</a>
			</nav>

			<div
				class="mt-auto max-md:col-span-2 max-md:m-0 max-md:flex max-md:items-center max-md:justify-between max-md:gap-5 max-sm:order-3"
			>
				<div
					class="flex max-w-52 flex-wrap gap-x-3.5 gap-y-2 max-md:max-w-none max-sm:gap-x-3 max-sm:gap-y-1.5"
				>
					<a
						class="text-xs text-muted underline-offset-4 hover:text-text hover:underline focus-visible:outline-none focus-visible:underline"
						href="https://www.upwork.com/freelancers/~014066482556c551be"
						target="_blank"
						rel="noreferrer"
					>
						Upwork
					</a>

					<a
						class="text-xs text-muted underline-offset-4 hover:text-text hover:underline focus-visible:outline-none focus-visible:underline"
						href="https://github.com/alifhaider"
						target="_blank"
						rel="noreferrer"
					>
						GitHub
					</a>

					<a
						class="text-xs text-muted underline-offset-4 hover:text-text hover:underline focus-visible:outline-none focus-visible:underline"
						href="https://linkedin.com/in/alifhaider"
						target="_blank"
						rel="noreferrer"
					>
						LinkedIn
					</a>

					<a
						class="text-xs text-muted underline-offset-4 hover:text-text hover:underline focus-visible:outline-none focus-visible:underline"
						href="https://x.com/haider_alif"
						target="_blank"
						rel="noreferrer"
					>
						X
					</a>
				</div>

				<div
					class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4 max-md:m-0 max-md:border-0 max-md:p-0"
				>
					<a
						class="text-xs text-muted underline-offset-4 hover:text-text hover:underline focus-visible:outline-none focus-visible:underline max-md:hidden"
						href="mailto:alifhaider57@gmail.com"
					>
						Email me ↗
					</a>

					<ThemeToggle />
				</div>
			</div>
		</aside>

		<!-- Main -->
		<main id="top" class="min-w-0">
			<!-- Hero -->
			<section class="border-b border-line py-20 max-md:py-14">
				<p class="mb-5 text-xs tracking-[0.02em] text-soft">Hi, I'm Alif.</p>

				<h1
					class="max-w-175 font-serif text-[clamp(3rem,7vw,4.875rem)] font-normal leading-none tracking-tight max-sm:text-5xl"
				>
					I build web applications.
				</h1>

				<div
					class="mt-8 grid grid-cols-[minmax(0,1fr)_240px] items-start gap-13 max-md:grid-cols-1 max-md:gap-7"
				>
					<p class="max-w-155 text-sm leading-7 text-muted">
						Most of my work is with React ecosystem — building the interface. I
						also spend a lot of time on the parts behind the interface — APIs,
						databases, realtime features, background jobs, and getting
						everything running in production.
					</p>

					<div
						class="border-l text-xs leading-normal text-muted border-line-strong pl-4.5 space-y-4 max-md:max-w-105"
					>
						<p>
							<span
								class="mb-1 block text-[10px] uppercase tracking-widest text-text"
							>
								Lately
							</span>
							Building full-stack applications with JavaScript and TypeScript —
							React, Next.js, React Router, Remix, Node.js, Prisma, Drizzle and
							more.
						</p>

						<p>
							<span
								class="mb-1 block text-[10px] uppercase tracking-widest text-text"
							>
								Usually
							</span>
							Working remotely with small teams and clients.
						</p>
					</div>
				</div>
			</section>

			<!-- Work -->
			<section id="work" class="pt-16">
				<div
					class="flex items-baseline justify-between gap-5 border-b border-line-strong pb-3.5 max-sm:pb-2.5"
				>
					<h2 class="text-sm font-semibold tracking-[0.01em]">
						Things I've built
					</h2>

					<span class="text-xs text-soft">2023—2026</span>
				</div>

				<div class="border-b border-line">
					{projects.map((project) => (
						<a
							class={rowClasses}
							href={project.href}
							target={project.href.startsWith("http") ? "_blank" : undefined}
							rel={project.href.startsWith("http") ? "noreferrer" : undefined}
							aria-label={`${project.title} — ${project.description}`}
						>
							<div class="text-[11px] text-soft">
								{project.year}
							</div>

							<div class="min-w-0">
								<h3 class="mb-1 text-base font-medium tracking-[-0.015em]">
									{project.title}
								</h3>

								<p class="text-xs text-muted">
									{project.description}
								</p>
							</div>

							<div
								class="text-right text-[11px] leading-normal text-soft max-md:hidden truncate"
							>
								{project.stack}
							</div>

							<span
								class="text-right text-sm text-soft transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-focus-visible:-translate-y-0.5 group-focus-visible:translate-x-0.5"
								aria-hidden="true"
							>
								↗
							</span>

							<div class={previewClasses} aria-hidden="true">
								{
									project.preview === "nulandia" && (
										<div class="grid h-full grid-cols-2 gap-2 overflow-hidden p-4 text-text">
											<b class="col-span-2 text-[11px] font-bold">
												Nulandia
											</b>

											<span class="border border-line p-2 text-[9px] text-muted">
												Content
											</span>

											<span class="border border-line p-2 text-[9px] text-muted">
												Weapons
											</span>

											<span class="border border-line p-2 text-[9px] text-muted">
												Quests
											</span>

											<i class="absolute right-4 top-4 h-0.5 w-5 bg-line-strong" />
										</div>
									)
								}

								{
									project.preview === "hyde" && (
										<div class="p-3.5">
											<div class="h-19 border border-line-strong bg-[repeating-linear-gradient(135deg,transparent_0_12px,var(--line)_13px_14px)]" />

											<span class="mt-3 block font-serif text-sm">
												Reserve your stay
											</span>
										</div>
									)
								}

								{
									project.preview === "definya" && (
										<div class="relative h-full bg-text p-4 text-bg">
											<span class="font-serif text-lg">
												DEF
											</span>

											<i class="absolute right-6 top-6 size-3.5 rounded-full border border-current opacity-70" />
											<i class="absolute right-13 top-14 size-3.5 rounded-full border border-current opacity-70" />
											<i class="absolute bottom-5 left-16 size-3.5 rounded-full border border-current opacity-70" />
										</div>
									)
								}

								{
									project.preview === "carehub" && (
										<div class="grid grid-cols-5 gap-1.5 p-4">
											<b class="col-span-5 mb-1 font-serif text-sm font-normal">
												June
											</b>

											<span class="text-center text-[7px] text-soft">
												Mon
											</span>

											<span class="text-center text-[7px] text-soft">
												Tue
											</span>

											<span class="text-center text-[7px] text-soft">
												Wed
											</span>

											<span class="text-center text-[7px] text-soft">
												Thu
											</span>

											<span class="text-center text-[7px] text-soft">
												Fri
											</span>

											<i class="mx-auto mt-1 block size-4.5 border border-text" />
										</div>
									)
								}

								{
									project.preview === "websec" && (
										<div class="p-4">
											<b class="mb-3 block text-[11px] font-medium">
												Overview
											</b>

											<i class="mb-2 block h-1.5 w-3/4 bg-line" />
											<i class="mb-2 block h-1.5 w-1/2 bg-line" />
											<i class="block h-1.5 w-2/3 bg-line" />
										</div>
									)
								}

								{
									project.preview === "studio" && (
										<div class="p-4">
											<span class="mb-3.5 block font-serif text-lg">
												Generate
											</span>

											<i class="mb-2 block h-1.25 w-[72%] bg-line" />
											<i class="block h-1.25 w-[51%] bg-line" />
										</div>
									)
								}
							</div>
						</a>
					))}
				</div>

				<p class="my-4 text-xs text-soft">
					There's more on
					<a
						class="text-text mx-1 underline-offset-4 hover:underline focus-visible:outline-none focus-visible:underline"
						href="https://github.com/alifhaider"
						target="_blank"
						rel="noreferrer"
						>GitHub ↗</a
					>
					and
					<a
						class="text-text mx-1 underline-offset-4 hover:underline focus-visible:outline-none focus-visible:underline"
						href="https://www.upwork.com/freelancers/~014066482556c551be"
						target="_blank"
						rel="noreferrer"
						>Upwork ↗</a
					>
					— including experiments that aren't ready for production.
				</p>
			</section>

			<!-- About -->
			<section id="about" class="border-t border-line pt-16">
				<div
					class="flex items-baseline justify-between gap-5 border-b border-line-strong pb-3.5 max-sm:pb-2.5"
				>
					<h2 class="text-sm font-semibold tracking-[0.01em]">About</h2>

					<span class="text-[11px] text-soft">A little context </span>
				</div>
				<div class="max-w-145 pt-6">
					<p class="text-sm leading-7 text-muted">
						I started out doing mostly frontend work. I liked making things look
						and feel right, but I kept getting curious about how things work
						under the hood.
					</p>

					<p class="mt-5 text-sm leading-7 text-muted">
						So I gradually moved further down the stack. Started working on
						databases, background jobs, APIs, realtime features, payments, and
						deployment.
					</p>

					<p class="mt-5 text-sm leading-7 text-muted">
						I like building things and understanding enough of the system to
						make them work properly.
					</p>
				</div>
			</section>

			<!-- Contact -->
			<section class="mt-6 border-b border-line py-16">
				<p class="mb-5 text-xs tracking-[0.02em] text-soft">
					Working on something interesting?
				</p>

				<h2
					class="mb-6 max-w-135 font-serif text-[clamp(2.125rem,5vw,3.25rem)] font-normal leading-none tracking-[-0.045em]"
				>
					Let's talk about it.
				</h2>

				<a
					class="text-sm underline-offset-4 hover:underline focus-visible:outline-none focus-visible:underline"
					href="mailto:hello@alifhaider.dev"
				>
					hello@alifhaider.dev ↗
				</a>

				<div class="mt-8 max-w-sm border-t border-line pt-4">
					<div class="flex items-end justify-between gap-6">
						<div>
							<p class="text-xs text-text">Résumé</p>

							<p class="mt-1 text-xs leading-5 text-muted">
								Experience, projects & contact details
							</p>
						</div>

						<a
							class="shrink-0 text-xs text-text underline decoration-line-strong underline-offset-4 transition-colors hover:decoration-text focus-visible:outline-none focus-visible:decoration-text"
							href="/resume.pdf"
							download="Alif-Haider-Resume.pdf"
						>
							Download ↘
						</a>
					</div>
				</div>
			</section>

			<!-- Footer -->
			<footer class="flex justify-between pt-6 pb-8 text-[11px] text-soft">
				<span>© 2021—{new Date().getFullYear()} Alif Haider</span>

				<span class="max-sm:hidden"> Built with Astro </span>

				<a
					class="underline-offset-4 hover:underline focus-visible:outline-none focus-visible:underline"
					href="#top"
					aria-label="Back to top"
				>
					↑
				</a>
			</footer>
		</main>
	</div>
</Layout>
