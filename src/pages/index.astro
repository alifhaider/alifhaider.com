---
import AboutSection from '../components/sections/AboutSection.astro'
import ContactSection from '../components/sections/ContactSection.astro'
import Footer from '../components/sections/Footer.astro'
import Hero from '../components/sections/Hero.astro'
import WorkSection from '../components/sections/WorkSection.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import Layout from '../layouts/Layout.astro'

const SOCIAL_LINKS = [
  {
    label: 'Upwork',
    href: 'https://www.upwork.com/freelancers/~014066482556c551be',
  },
  { label: 'GitHub', href: 'https://github.com/alifhaider' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/alifhaider' },
  { label: 'X', href: 'https://x.com/haider_alif' },
]

const NAV_LINKS: { label: string; href: string; current?: boolean }[] = [
  { label: 'Work', href: '#work', current: true },
  { label: 'About', href: '#about' },
  { label: 'Blog', href: '/blog/' },
]
---

<Layout title="Alif Haider - Software Engineer">
	<div
		class="mx-auto grid max-w-295 grid-cols-[230px_minmax(0,1fr)] gap-18 px-7 max-md:block max-md:max-w-175 max-md:px-4 max-sm:px-3"
	>
		<!-- Sidebar -->
		<aside
			class="sticky top-0 flex h-screen flex-col py-8 pb-7 max-md:static max-md:grid max-md:h-auto max-md:grid-cols-[1fr_auto] max-md:gap-5 max-md:border-b max-md:border-line max-md:py-6 max-md:pb-4 max-sm:grid-cols-1"
		>
			<div>
				<a
					class="link inline-block font-serif text-3xl tracking-[-0.035em]"
					href="#top"
				>
					Alif Haider
				</a>

				<p
					class="mt-1 text-sm leading-normal font-medium text-muted max-sm:mt-1"
				>
					Software engineer<br>
					<span class="text-xs font-normal mr-1">based in</span>
					Bangladesh.
				</p>
			</div>

			<p
				class="mt-16 pr-3.5 max-md:hidden text-[13px] leading-relaxed text-muted"
			>
				I build web applications with JavaScript and TypeScript, from the
				interface to the backend.
			</p>

			<nav
				class="mt-9 grid gap-2.5 text-[13px] max-md:col-span-2 max-md:mt-2.5 max-md:flex max-md:gap-5 max-sm:order-2 max-sm:mt-1"
				aria-label="Primary navigation"
			>
				{NAV_LINKS.map(({ label, href, current }) => (
					<a
						class="link w-fit"
						href={href}
						aria-current={current ? 'page' : undefined}
					>
						{label}
					</a>
				))}
			</nav>

			<div
				class="mt-auto max-md:col-span-2 max-md:m-0 max-md:flex max-md:items-center max-md:justify-between max-md:gap-5 max-sm:order-3"
			>
				<div
					class="flex max-w-52 flex-wrap gap-x-3.5 gap-y-2 max-md:max-w-none max-sm:gap-x-3 max-sm:gap-y-1.5"
				>
					{SOCIAL_LINKS.map(({ label, href }) => (
						<a
							class="link text-xs text-muted"
							href={href}
							target="_blank"
							rel="noreferrer"
						>
							{label}
						</a>
					))}
				</div>

				<div
					class="mt-5 flex items-center justify-between gap-3 border-t border-line pt-4 max-md:m-0 max-md:border-0 max-md:p-0"
				>
					<div class="grid gap-1.5 max-md:hidden">
						<a
							class="link link-hover text-xs text-muted"
							href="mailto:alifhaider57@gmail.com"
						>
							Email me ↗
						</a>

						<a
							class="link link-hover text-xs text-muted"
							href="https://cal.com/alifhaider/30min"
							target="_blank"
							rel="noreferrer"
						>
							Book a call ↗
						</a>
					</div>

					<ThemeToggle />
				</div>
			</div>
		</aside>

		<!-- Main -->
		<main id="top" class="min-w-0">
			<Hero title="I build web applications." />

			<WorkSection />

			<AboutSection />

			<ContactSection />

			<Footer />
		</main>
	</div>
</Layout>
